PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creamy_cream?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ACCESS_JWT_SECRET=replace-with-long-random-secret
REFRESH_JWT_SECRET=replace-with-different-long-random-secret

# MinIO S3 API endpoint: host:port (not http://host:port).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=creamy-cream
MINIO_USE_SSL=false

# Publicly reachable base URL of THIS Go API, for /media/... image URLs.
# In production use HTTPS and configure the public API hostname.
PUBLIC_API_URL=http://localhost:3000

# Comma-separated exact frontend origins. Required in production.
# Do not use '*' when sending credentialed refresh cookies.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Optional RajaOngkir Komerce shipping quote provider. Configure BOTH or neither.
# In production the base URL must use HTTPS. No API key is sent to frontend.
RAJAONGKIR_BASE_URL=
RAJAONGKIR_API_KEY=

# Shared Redis-backed public quote limit per client IP, per 60 seconds.
RAJAONGKIR_RATE_LIMIT_PER_MINUTE=30

# Maximum total RajaOngkir requests per minute across ALL client IPs and replicas.
# Keep this at or below the upstream quota for your API key.
RAJAONGKIR_GLOBAL_RATE_LIMIT_PER_MINUTE=30

# Optional comma-separated IPs/CIDRs of your trusted reverse proxy only.
# Leave empty for direct deployments; NEVER use 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=
